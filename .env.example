# Copy to .env and fill in. Never commit the real .env.

# --- Asta config (never commit this file) ---

# What your assistant calls itself (UI branding + persona). Rename freely.
ASSISTANT_NAME=Asta

# Auth token required for API/WS access (used by the web UI login and the phone).
ASTA_TOKEN=

# Hosted model keys — fill in the ones you have. Models without a key are
# hidden from the UI picker automatically.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model name overrides (defaults shown)
ASTA_CLAUDE_MODEL=claude-sonnet-5
ASTA_OPENAI_MODEL=gpt-4o

# Local LLM (LM Studio / Ollama — any OpenAI-compatible endpoint)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# GitHub PAT for the github MCP server.
# TODO(arun): ROTATE this token — it was sitting in plaintext in
# ~/.config/github-copilot/intellij/mcp.json. Generate a new fine-grained PAT
# and paste it here, then remove it from the IDE file.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Server bind. 127.0.0.1 = laptop only. For phone access via Tailscale use
# your tailnet IP (tailscale ip -4), e.g. ASTA_HOST=100.x.y.z
ASTA_HOST=127.0.0.1
ASTA_PORT=8321

# --- Jira (read-only) --------------------------------------------------------
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_WATCH_JQL=assignee = currentUser() AND statusCategory != Done
# What "the current sprint" means for your board. The default uses openSprints(),
# which needs no board id and works on a fresh install. Boards without Jira
# Software have no sprint field at all — point this at whatever "current work"
# means for you (e.g. a Kanban column) and the sprint view starts working.
JIRA_SPRINT_JQL=sprint in openSprints() AND assignee = currentUser() ORDER BY status ASC

# --- Missions ----------------------------------------------------------------
# Headless implementation engine: copilot (GitHub Copilot CLI) or claude (Claude Code CLI).
# The verify/test pass always uses claude.
ASTA_EXECUTOR=copilot

# --- Copilot CLI chat model ---------------------------------------------------
# Day-to-day chat runs through the office `copilot` CLI (auto-detected, no key
# needed). Optionally pin the CLI's model (must be a valid `copilot --model` id;
# leave empty to let Copilot pick):
COPILOT_CLI_MODEL=

# --- WhatsApp bridge ---------------------------------------------------------
# (8322 was busy on this machine — another local Python service uses it)
WA_BRIDGE_PORT=8323
WA_BRIDGE_URL=http://127.0.0.1:8323
# Restrict to a specific chat JID; empty = your own "Message yourself" chat.
WA_ALLOWED_JID=

# --- How Asta learns you were pinged on Teams --------------------------------
# TWO independent triggers. The Playwright one is the default and needs no
# special OS permission; the notification-DB one is an OPTIONAL low-latency
# add-on.
#
#  1. Playwright activity poll (DEFAULT — TEAMS_ACTIVITY_POLL below, further down).
#     Reads the Teams Activity feed in a real browser. This is the same path that
#     already does the reading, replying and sending, so it is the full-capability
#     workhorse. Sees muted chats and DND, works with banners off, needs NO Full
#     Disk Access. Latency = the poll interval.
#
#  2. Notification-DB watcher (OPTIONAL — TEAMS_WATCHER=1). Reads macOS
#     Notification Center banners straight from SQLite: near-instant and free, but
#     read-only, blind to muted/DND chats, and it needs Full Disk Access on the
#     process that launchd runs (see deploy/install.sh). Leave it 0 unless you
#     specifically want sub-poll-interval ping alerts AND have granted FDA — the
#     Playwright poll above already covers the same mentions.
TEAMS_WATCHER=0
# Keywords that mark a mention as "about me" (used by BOTH triggers; default:
# your username + "mention"):
TEAMS_WATCH_KEYWORDS=

# --- Context / graph auto-refresh -------------------------------------------
# Refresh fires when code actually changed (new commits / 40+ dirty files,
# checked every 10 min — free, pure git). Weekly baseline as a safety net:
REFRESH_EVERY_DAYS=7
REFRESH_AT=18:30
# Command that regenerates graphify for a workspace (run at workspace root;
# "{workspace}" is replaced with the workspace path). Example:
#   GRAPHIFY_CMD=node /path/to/graphify-cli.js {workspace}
GRAPHIFY_CMD=

# Telegram bot channel (official API — see app/telegram.py header for 2-min setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Teams web bridge (Playwright; login once: .venv/bin/python -m app.teams_bridge login)
TEAMS_BRIDGE=1

# Daily rhythm (weekdays; HH:MM local, empty disables)
BRIEF_TIME=08:30
STANDUP_TIME=09:15

# --- Watcher cadence ---------------------------------------------------------
# Outlook inbox + Teams activity poll, seconds. 300 = every 5 min. This Teams
# poll IS the default ping trigger (see TEAMS_WATCHER above) — it reads the
# Activity feed in Playwright, no Full Disk Access needed. Each poll drives a
# real browser session (~10-25s), so these are the practical floor; 0 disables.
OUTLOOK_POLL=300
TEAMS_ACTIVITY_POLL=60

# --- Waking up after the lid was shut ----------------------------------------
# A poll timer does not advance while the Mac is suspended, so after an overnight
# sleep the watchers used to resume mid-interval and idle out the rest of it
# before scanning — on top of the hours already missed. Asta now compares the
# wall clock against the monotonic one; the difference IS the time spent asleep.
#
# How long a gap has to be before it counts as sleep rather than a busy event
# loop. Below this nothing happens, so a slow turn never triggers a catch-up.
ASTA_WAKE_MIN_GAP=180
# How long a gap has to be before Asta SAYS it was away, as opposed to quietly
# catching up. Closing the lid to walk to a meeting room does not need an
# announcement; an overnight does. The scan happens either way.
ASTA_WAKE_ANNOUNCE_AFTER=1800
# How long to wait for the network after waking before scanning anyway. The
# first poll after a wake otherwise fires into an interface that has not
# reassociated, fails, and waits another full interval.
ASTA_WAKE_NET_WAIT=120
# Reachability probe — one TCP handshake, no DNS, no HTTP. If your network
# blocks this host, Asta scans anyway rather than staying silent; point it at
# something reachable to get the wait behaviour back.
ASTA_WAKE_PROBE_HOST=1.1.1.1
ASTA_WAKE_PROBE_PORT=443
# How many times a time-windowed Teams read may scroll the thread up to reach
# older messages. Teams virtualises the list, so "last night" is genuinely not
# in the DOM until it is fetched. Each scroll costs about a second.
TEAMS_MAX_SCROLLBACK=12

# --- Work that outlives the diff ---------------------------------------------
# A code task used to end the moment its diff was written, so the PR it later
# became was tracked nowhere: CI going red on it, a review comment, and the
# merge itself all arrived with nothing that knew which task they belonged to.
# A shipped task now stays open until its PR merges or closes.
#
# How often to ask GitHub what happened to those open PRs. A PR is a slow
# object — CI takes minutes, review takes hours — so polling harder buys
# nothing and spends rate limit.
ASTA_PR_POLL=300
# How long after a task finishes its work still counts as "the thing we were
# just doing", so feedback CONTINUES it instead of spawning a fresh task that
# re-derives everything from nothing. Past this, a similar-sounding request is
# treated as genuinely new work.
ASTA_REFINE_WINDOW=21600

# --- Copilot spend controls --------------------------------------------------
# Reasoning effort per stage: none|minimal|low|medium|high|xhigh|max.
# Effort is the single biggest dial on spend — investigation cheap,
# implementation is where the quality money goes.
COPILOT_EFFORT=medium
COPILOT_EFFORT_ANALYSIS=low
COPILOT_EFFORT_PLAN=medium
COPILOT_EFFORT_CODE=high
COPILOT_EFFORT_TASK=medium
# Hard ceiling per invocation (--max-ai-credits). Empty = no cap.
COPILOT_MAX_CREDITS=
COPILOT_MAX_CREDITS_TASK=
# Pin the Copilot CLI model (must be a valid `copilot --model` id); empty = auto.

# --- Claude CLI (subscription) -----------------------------------------------
# Runs on the Claude subscription, so there are no credits to cap — the limit is
# a rolling 5-hour usage window. Effort is the dial that matters.
# Each stage falls back to the COPILOT_EFFORT_* value above when left empty.
ASTA_CLAUDE_CLI_MODEL=
ASTA_CLAUDE_EFFORT=
# Per-stage overrides use the cascade below, NOT this prefix. The three names
# once listed here (ASTA_CLAUDE_EFFORT_ANALYSIS/PLAN/CODE) were never read by
# anything — agent.effort_for builds ASTA_EFFORT_<MODEL>_<STAGE> — so setting
# them looked like tuning and did nothing. Use ASTA_EFFORT_CLAUDE_CODE etc.

# --- Voice (local Voicebox) --------------------------------------------------
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=kokoro
VOICEBOX_PROFILE=

# --- Status window -----------------------------------------------------------
# "Is it still working?" = live only. "What did I miss?" = the recap window.
ASTA_STATUS_RECENT=1800
ASTA_STATUS_RECAP=86400

# --- Effort, any model -------------------------------------------------------
# Cascade, most specific first:
#   ASTA_EFFORT_<MODEL>_<STAGE>   e.g. ASTA_EFFORT_CLAUDE_CLI_CODE=max
#   ASTA_EFFORT_<STAGE>           applies to every model
#   COPILOT_EFFORT_<STAGE>          legacy name above, still honoured
# STAGE = ANALYSIS | PLAN | CODE | TASK.  Models without an effort ladder
# (Claude API, LM Studio) ignore these.
ASTA_EFFORT_ANALYSIS=
ASTA_EFFORT_PLAN=
ASTA_EFFORT_CODE=
ASTA_EFFORT_TASK=

# Pre-meeting heads-up: minutes before a meeting to ping (0 disables).
ASTA_PREMEET_MINUTES=30

# --- Alert triage / recall ---------------------------------------------------
# Hold a SOFT alert (a number moved) this long; a recovery inside the window drops
# both and you never hear about it. Real breakage — pods down, connection refused,
# P1, crashloop — ignores this entirely and goes out immediately, and you are told
# again when it recovers. Was 20, which meant a genuine outage sat silent for the
# first third of an hour.
ASTA_ALERT_HOLD_MINUTES=5
# ServiceNow incidents assigned to your group are kept by default (real work).
ASTA_SUPPRESS_SERVICENOW=0
# How often each watcher looks. These are the ceiling on how late any
# notification can be — a 5-minute hold behind a 30-minute poll is a
# 30-minute hold, so the numbers have to agree.
ASTA_CI_POLL=300
# Recall: embedding model (empty = first model loaded in LM Studio) and the
# recency half-life in days used to break near-ties.
ASTA_EMBED_MODEL=
ASTA_RECALL_HALFLIFE=45

# --- Workspaces --------------------------------------------------------------
# Where the workspace registry lives (default: data/workspaces.json). Workspaces
# are configured at runtime from the UI — nothing is hardcoded.
ASTA_WORKSPACES_FILE=
# Directory name a workspace keeps its generated project context in.
ASTA_CONTEXT_DIRNAME=.asta-context
# One-time migration of a pre-registry install's single hardcoded workspace.
ASTA_LEGACY_WORKSPACE=

# --- Tool selection ----------------------------------------------------------
# Rank capabilities against each message and expose only the relevant ones plus a
# small always-available core. Set to 0 to put every tool in every turn again.
ASTA_TOOL_RAG=1
# How many ranked capabilities to expose before the always-set is added.
ASTA_TOOL_TOP_K=8
# Below this score a hit is noise, not a match.
ASTA_TOOL_MIN_SCORE=0.25

# --- Learning ----------------------------------------------------------------
# Extracted skills below this confidence are discarded rather than stored: a
# wrong procedure gets followed confidently, which is worse than none at all.
ASTA_SKILL_MIN_CONFIDENCE=0.6

# --- Mid-turn intent classification ------------------------------------------
# Which brain classifies an interjection as augment/redirect/status.
# Empty = whichever brain the conversation uses. 'off' = heuristics only.
# 'local' keeps it free/instant on LM Studio instead of spawning a paid CLI.
ASTA_INTENT_BRAIN=

# --- WhatsApp bridge supervision ---------------------------------------------
# 1 (default): Asta starts the Node bridge as a child and restarts it on crash.
# 0: you (or launchd) own the bridge; Asta uses it but never spawns/kills it.
ASTA_WA_SUPERVISE=1

# --- CLI brains: native MCP tools instead of curl ----------------------------
# 0 (default): Copilot/Claude CLI reach Asta's capabilities by curling the API.
# 1: they call them as native `asta` MCP tools that forward to /api/_invoke.
# NOTE: MCP does NOT save tokens — it adds ~4k/turn of tool schemas; the real win
# is reliability (typed calls, no hand-written curl) and lower latency (no bash
# subprocess per call). Opt-in cutover; enable after a real-turn test. The running
# server must be reachable at ASTA_PORT/ASTA_URL.
ASTA_CLI_MCP=0

# --- Autonomous loop ---------------------------------------------------------
# 1 (default): when a turn isn't finished and the model already knows the next
# step, Asta runs it automatically instead of stopping to wait for your message —
# so a task drives itself to completion. Bounded by ASTA_LOOP_MAX_STEPS per
# message, and anything outward-facing (a Teams reply, email, Jira comment, PR
# body) is ALWAYS staged for your "send?" confirmation first — never auto-sent.
# 0: every turn stops and waits for your next message (the old reactive behaviour).
ASTA_LOOP=1
# How many times one message may auto-continue before Asta pauses and hands back.
# Was 4, which meant four back-to-back CLI turns — twenty-plus minutes of silence.
ASTA_LOOP_MAX_STEPS=2
# Wall-clock ceiling (seconds) on everything ONE message may trigger, reset each
# time you speak. A step COUNT cannot bound a wait — each step is a whole CLI turn
# of unknown length — so time is budgeted directly. 0 disables the deadline.
ASTA_LOOP_DEADLINE=600

# --- Per-turn ceiling (every CLI brain) --------------------------------------
# How long ONE CLI turn may run before it is abandoned as wedged. Shared by every
# CLI brain so behaviour can't drift between them. Was a hard 10 minutes, which is
# most of why a reply could take twenty; 5 minutes is longer than any turn that was
# ever going to succeed.
ASTA_TURN_TIMEOUT=300

# --- Extended thinking (API path) --------------------------------------------
# Deeper reasoning on the in-process Claude brain, at the cost of thinking tokens
# on every turn — off by default because that fights the token-wastage goal.
# Empty/0 = off; on|1 = a modest 2048-token budget; or set an explicit budget,
# e.g. ASTA_THINKING=4096. CLI brains (Copilot/Claude CLI) reason via the effort
# ladder above instead, so this only affects the Claude API brain.
ASTA_THINKING=

# --- Brain-router (local-first for trivial turns) ----------------------------
# 1 (default): answer pure pleasantries ("hi", "thanks", "great") on the free local
# model / a canned line instead of spawning a paid CLI (~24k tokens) to say hello.
# Only diverts self-contained social turns — real content always hits the picked
# brain. 0 disables. (Routing short factual Q&A to local too is a future extension.)
ASTA_ROUTER=1

# --- Notification etiquette ---------------------------------------------------
# Ambient items (CI chatter, general traffic) are held while you're at the laptop
# so they don't interrupt. But "at the laptop" is true whenever you're touching the
# machine — including afternoons you close Teams and Outlook and work on something
# else — so a departure-only rule could hold them for hours. This is the courtesy's
# expiry: past this many minutes they're delivered wherever you are. 0 disables the
# age release (departure-only, the old behaviour).
ASTA_HOLD_MAX_MINUTES=45

# --- Offers ("something broke — can I look?") ---------------------------------
# When Asta spots a problem it reports it with the detail you need and offers the
# next step; a bare "yes" from any channel runs it, and the chain continues
# (analyse -> raise the PR -> share the build for approval), asking between each.
# How long an unanswered offer stays answerable, in seconds (default 6h) — so a
# "yes" tomorrow can't kick off work you've forgotten proposing. 0 = never expires.
ASTA_OFFER_TTL=21600

# --- Resuming after a brain runs out ------------------------------------------
# When a model hits its quota mid-task, Asta keeps a checkpoint — the request,
# what had already been established, and where it stopped — and hands THAT to
# whoever takes over, so the next brain continues instead of starting again. If
# nothing is available, the checkpoint waits: "resume" or "use <brain>" from any
# channel picks it up. How long it stays resumable, in seconds (default 24h);
# past that, the branch has moved and so have you. 0 = never expires.
ASTA_RESUME_TTL=86400

# --- Calls --------------------------------------------------------------------
# Asta can JOIN a Teams meeting (muted, camera off) with no extra setup. To be
# HEARD in one it needs a virtual microphone that Teams can select as its input —
# BlackHole or Loopback on macOS. Set this to the device name once that exists.
# Left empty, "say this in the call" refuses and says why, rather than generating
# audio nobody hears and reporting success.
ASTA_CALL_AUDIO_DEVICE=
# A joined call is left after this long no matter what, so an overrunning meeting
# can't leave Asta sitting in someone's call all day.
ASTA_MAX_CALL_MINUTES=90
# How often the live captions are read while in a call, in seconds. Teams scrolls
# captions out of their window within seconds, and one missed is gone for good —
# so this is deliberately far more frequent than the call-ended check. Meeting
# notes are built from these; without them a recap has nothing to summarise
# unless someone recorded the meeting.
ASTA_CAPTION_POLL=2

# How long a placed call rings before Asta hangs up. Nobody who has not picked up
# in this long is about to, and a call left ringing holds the browser context —
# and therefore the next call — open forever.
ASTA_RING_SECONDS=45

# How long an answer may take before it is too late to say out loud. Measured on
# this machine: a warm voice line costs ~1.1s to synthesise and ~0.4s to switch
# the mic, so this budget is almost entirely thinking time. Past it the answer
# goes to his phone instead of arriving in the call long after anyone cared.
ASTA_ANSWER_BUDGET=25

# Words cap on anything Asta says out loud in a call. The full answer always goes
# to his phone; nobody listens to four paragraphs read aloud.
ASTA_SPOKEN_ANSWER_WORDS=45

# Holding an actual two-way conversation on a call (discuss_in_call).
#
# The ceiling matters more than it looks: a call Asta forgets to end holds the
# microphone and leaves `_CALL` set, and every later call is then refused as
# "already in a call" until the server restarts.
ASTA_CONVERSE_SECONDS=240
# Silence that ends their turn and hands the floor back.
ASTA_HEAR_SECONDS=14
# Replies before Asta winds up regardless — someone who has answered this many
# times has given his answer.
ASTA_CONVERSE_TURNS=8

# How Teams names Arun in a caption. The moment one of these is heard speaking,
# Asta stops talking for the rest of the call — it is his conversation.
ASTA_HIS_TEAMS_NAMES=arun,arun k,arun kumar

# --- What wants you, and how much (all OFF by default) ------------------------
# Every source records into one ledger and one policy decides, instead of
# thirty-four call sites each deciding alone and forgetting. Turning this on is
# what enables ranking, cross-source dedup ("one incident, one interruption")
# and "what's on my plate" as a query rather than a re-scrape.
ASTA_ATTENTION=
# When the working day ends, for reading "by EOD" as a real time.
ASTA_EOD_HOUR=18
# A deadline closer than this many hours makes an ask interrupt rather than wait.
ASTA_URGENT_HOURS=4
# How many sightings of an unanswered thing before it counts as being chased and
# outranks whatever the wording of the first message said.
ASTA_CHASE_AT=3
# How long a watcher may go without a SUCCESSFUL read before it is called broken.
# Not behind a flag: both watchers swallow exceptions and continue, so a dead
# scrape reads as a quiet week. 0 disables.
ASTA_STALE_AFTER_MINUTES=90

# --- Who matters, learned rather than listed ---------------------------------
# A prior over senders, built from what you actually do. Needs ASTA_ATTENTION —
# it re-ranks what the ledger ranked. Reputation is recorded even while this is
# off, so switching it on later starts with real history.
# It can quiet noise but never silences a question, never re-ranks breakage, and
# never mutes someone whose meetings you sit in.
ASTA_CONTACTS=
# Labelled interactions needed before a person's rate is used at all.
ASTA_CONTACT_MIN_EVIDENCE=5
ASTA_CONTACT_HIGH=0.7
ASTA_CONTACT_LOW=0.15

# --- When to say it ----------------------------------------------------------
ASTA_DELIVERY=
# Only breakage earns the night; an L2 ticket is real work that can wait until
# seven. Unranked pushes (a reminder you set, a task finishing) always go out.
# Leave empty for no quiet hours. An unparseable value disables it rather than
# guessing — being wrongly silent is the failure worth engineering against.
ASTA_QUIET_HOURS=22:00-07:00
# Merge pushes arriving within this many seconds into one message. 0 disables.
ASTA_COALESCE_SECONDS=120

# --- Meetings ----------------------------------------------------------------
# Per-type pre-meeting lead, clash and back-to-back warnings, "do I need to be
# there", and joining a meeting you NAME ("join my 3pm") rather than link.
ASTA_MEET2=

# ==============================================================================
# Flags that shipped without ever being written down here (added 2026-08-03)
# A test now fails if code reads an ASTA_ setting this file does not mention, so
# this section cannot silently fall behind again.
# ==============================================================================

# --- Verifier gate: loop a code task to green against the repo's own check ----
ASTA_VERIFY=1
# The command that decides "green". Empty = resolve it from the repo itself.
ASTA_VERIFY_CMD=
ASTA_VERIFY_MAX_ROUNDS=2
ASTA_VERIFY_TIMEOUT=1200

# --- Relevance gate: catch intent drift before it spawns work -----------------
# A passive question turning into a side-effecting spawn is held for a confirm.
ASTA_RELEVANCE=

# --- Coding-brain tooling -----------------------------------------------------
# Serena (symbol-level nav/edit) + Context7 (version-correct docs) for the CLI
# brains spawned on code tasks. Missing binary is skipped, never fatal.
ASTA_DEV_MCP=
ASTA_SERENA_CMD=serena
ASTA_CONTEXT7_CMD=context7-mcp
# Keep the plan you approved as a resumed task's definition of done.
ASTA_TASK_SPEC=

# --- Model choices for the cheap classifier paths -----------------------------
ASTA_INTENT_MODEL=claude-haiku-4-5-20251001
ASTA_INTENT_OPENAI_MODEL=gpt-4o-mini
# Overrides the model in tests only; leave empty in a real .env.
ASTA_TEST_MODEL=

# --- Timing knobs -------------------------------------------------------------
# Wall-clock ceiling for one turn, in seconds — the bound that keeps a runaway
# turn from hanging the assistant.
ASTA_TURN_CEILING=420
# How long a context prefetch may take before the turn proceeds without it.
ASTA_PREFETCH_TIMEOUT=25
# How long a WhatsApp turn waits for an in-band answer before going async.
ASTA_WA_INBAND_TIMEOUT=20

# --- Memory recall ------------------------------------------------------------
# Similarity below this is not worth resurfacing, so weak matches stay out.
ASTA_RECALL_FLOOR=0.35

# --- Discovery paths (empty = the built-in defaults) --------------------------
# Extra directories for agent definitions, skills, and context building.
ASTA_AGENTS_DIR=
ASTA_SKILL_PATHS=
ASTA_CONTEXT_DIRNAMES=
ASTA_CONTEXT_RESOURCES=
# Narrow the MCP tool set exposed to a brain; empty = the configured servers.
ASTA_MCP_TOOLS=
# The conversation an MCP subprocess is answering in. Set per-turn by the CLI
# runners, never by hand — capabilities that read the conversation
# (prepare_to_send, continue_working) reach the server as a fresh HTTP request,
# which carries none of the chat path's context, and without this they fail.
ASTA_MCP_CONV=

# --- MCP server -------------------------------------------------------------
# Where the MCP server tells a brain to reach Asta. Defaults to
# http://127.0.0.1:$ASTA_PORT — set it only when Asta is behind Tailscale or a
# different host, or a spawned brain will curl a machine that is not this one.
ASTA_URL=

# Where the context-engine generator scripts live. Asta bundles them with its
# workspace-context skill, so this is only needed on a machine that keeps them
# elsewhere (e.g. the shared contmark plugin checkout).
ASTA_CONTEXT_RESOURCES=

# --- Speaking in calls -------------------------------------------------------
# Two voices, chosen in words: "talk like me" uses the clone, "talk like
# assistant" uses the preset. Unrecognised always falls back to the assistant —
# his voice is never reached for on a parse failure.
# Measured on an M1 Pro: assistant ~1.3s a line; the clone ~3.4x real time.
VOICEBOX_CLONE_PROFILE=Arun
VOICEBOX_CLONE_ENGINE=chatterbox
# Your real microphone, restored after every utterance Asta speaks. Teams
# listens to ONE input, so Asta borrows the virtual mic to be heard and gives
# this one back immediately — forget the restore and you are silently muted for
# the rest of the call.
ASTA_HIS_MIC=MacBook Pro Microphone
# macOS input switcher (brew install switchaudio-osx). Asta points the SYSTEM
# default input at the virtual mic to speak and puts it straight back — Teams
# follows the system default as long as its own device is left on "Same as
# System". Driving Teams' own picker in Playwright was tried first and failed
# every selector against live Teams, which would have meant a call connecting
# and then sitting silent.
ASTA_SWITCH_AUDIO=/opt/homebrew/bin/SwitchAudioSource

# How much workspace context the resolver may inject. It is documented as routing
# to "the ~350 tokens that matter"; the cap used to be 20,000 characters (~5,000
# tokens) pushed in before the model had read the question. 6,000 chars is ~1,500
# tokens — room for a real answer at a quarter of the old ceiling.
ASTA_RESOLVE_CHARS=6000

# Whether a finished code task reads its own diff before handing it over. The PR
# reviewer already existed and was only ever pointed at other people's pull
# requests — the code Asta itself wrote went out unread by Asta, with Arun's own
# eyes as the only safety net. That is what makes him the bottleneck.
ASTA_REVIEW_OWN_DIFF=1

# How long a pooled Teams browser lives before being recycled regardless of health.
# One context is kept alive and reused across operations — 2.49s of launch and app
# boot used to be paid on EVERY read, send and poll; measured after pooling, a
# second operation costs 0.01s. A browser alive for hours grows, and Teams' session
# handling is happier with a fresh app boot now and then.
TEAMS_POOL_MAX_AGE=1800

# How many code tasks may hold checkouts in one workspace at once. This replaced a
# LOCK held for up to thirty minutes, so two tickets in the same repo ran strictly
# one after the other — capping throughput at roughly one developer's, which is the
# main advantage an assistant has over one. Tasks now get private git worktrees and
# share nothing, so the limit is the machine (a checkout + a CLI + a Maven build
# each), not the git model. Arun is working on this laptop while they run.
ASTA_MAX_PARALLEL_TASKS=3

# How many tools a conversation carries between turns. Retrieval picks ~8 a turn;
# the set that carried them across turns only ever GREW — measured at 23, 26, 31,
# 36, 37, 44 of 58 across six ordinary turns, then latched to everything for the
# rest of the conversation. So the longer a conversation ran the more each turn
# cost (~5,950 tokens of schemas before Arun had said anything), and it never
# recovered. Bounded by recency instead: ~2,191 tokens, a 63% saving per turn.
ASTA_TOOL_STICKY_MAX=24

# Require a second opinion before Asta says an ANSWER out loud in a call. The
# classifier is regexes, which is right for deciding whether to put something on
# his phone — a false positive costs a glance — and wrong for deciding what to
# say: "can you check how the amend flow handles that" and "how does the amend
# flow handle that" differ by three words and by who is committed to an answer.
# Local model only; if it is not running the answer is no, because silence is
# always safe in a conversation and an unnecessary sentence never is.
ASTA_CONFIRM_SPEECH=1

# How far a conversation's toolset may grow past ASTA_TOOL_STICKY_MAX before it
# is trimmed back. Without this gap the set sits exactly at the cap and every turn
# evicts something to make room — measured as one tool in and one out on two
# consecutive turns about the SAME subject, changing the tool block and missing a
# prompt cache that should have hit. With it, trimming happens about once every
# eight new tools instead of every turn.
ASTA_TOOL_STICKY_SLACK=8

# Where the Temporal MCP proxy lives. Asta READS its ENV_MAP rather than keeping
# its own copy of the env -> cluster/namespace/cert mapping — two copies is how a
# newly added env goes missing in one of them. Only change this if the proxy moves.
ASTA_TEMPORAL_PROXY=

# Which LM Studio model answers local turns. Unset = the first CHAT model the
# server lists, which depends on load order — and the models differ by more than
# 2x: measured on this machine, google/gemma-4-e4b answered in 15.9s and
# qwen/qwen3.5-9b in 38.9s, the difference being reasoning tokens nobody reads.
# Embedding models are never picked regardless; a pin naming an unloaded model
# falls through rather than disabling every local call.
ASTA_LOCAL_MODEL=

# How long a CLI brain may produce NOTHING before it is treated as wedged. The
# turn ceiling (ASTA_TURN_TIMEOUT) bounds total time; this bounds silence, and the
# two answer different questions. A brain streaming progress every few seconds is
# working and deserves its full budget; one silent for this long is stuck, and more
# time will not help. Before this existed both were killed at the same moment with
# the same message, which is why a timeout never said whether the work was done,
# still going, or hung.
ASTA_TURN_IDLE=120

# How many read-only questions Asta may answer ALONGSIDE work already running.
# A question like "what's the CI status" has no conflict with an implementation in
# flight, and queueing it behind one is why a one-line answer waited forty minutes.
# Bounded because each is a real brain turn. Side turns cannot reach any capability
# that writes, so the intent classifier only has to be useful, not perfect.
ASTA_SIDE_TURNS_MAX=2

# How many offers may wait behind the one Arun is actually being asked. Offers used
# to live in a single slot that every new one overwrote — so a background daemon
# could replace the question on his screen and his "yes" would land on something he
# never read. They queue now; past this the oldest is dropped, because a backlog he
# will never work through is just a way to lose the recent ones.
ASTA_OFFER_QUEUE_MAX=5

# A code task's budget is a function of SCOPE, not a flat number: base, plus room
# per repo it could touch, capped. Verification is per-repo — `mvn clean test` on
# each — so a change landing across three repos pays it three times, while a
# one-line fix in one repo should not be given the same hour. Defaults give 35 min
# for one repo (clearing the measured p90 of 32) and 65 for three.
ASTA_CODE_BASE_SECONDS=1200
ASTA_CODE_PER_REPO_SECONDS=900
ASTA_CODE_MAX_SECONDS=5400

# Whether a CLI subscription (copilot / claude cli) answers a code question BEFORE
# an in-process model. On by default, on Arun's instruction and on the evidence:
# best_model_name() resolves to the local LM Studio model on this machine, which
# measured 15.9s (gemma-4-e4b) to 38.9s (qwen3.5-9b) for a single lookup and is
# weaker on exactly the questions worth asking. The CLI brains are subscriptions
# already paid for and they read the workspace directly. Set 0 to prefer an
# in-process model, which is right when a hosted API key actually works.
ASTA_CLI_FIRST=1

# Whether the CHAT brain may edit files. Off by default, which is the fix for
# "Copilot CLI turn timed out after 300s": a chat turn is capped at
# ASTA_TURN_TIMEOUT and a real implementation does not fit in it, so work is
# routed to a code task instead (35-65 min, with a plan gate). Denying `edit` in
# chat is the backstop for anything the router misses — bash, view and grep stay,
# because reading is most of what chat legitimately does. Task runs are untouched:
# implementing is their whole job. Set 1 if you want chat to write code again.
ASTA_CHAT_MAY_EDIT=0

# --- Self-healing -------------------------------------------------------------
# Detection has always worked here; this is the part that acts. When a watcher
# goes stale, a ladder of repairs runs cheapest-first (recycle the browser,
# restart the subsystem, clear the wedged profile store) and Arun is told ONLY if
# every rung fails — with a list of what was tried. Set 0 to go back to being
# told about faults instead of having them fixed.
ASTA_RECOVERY=1
# Consecutive failed polls before repair starts. One failure is a hiccup (the
# network has not reassociated after the lid opens); three is a pattern.
ASTA_RECOVERY_THRESHOLD=3
# Minimum seconds between repair attempts for one source. Repairing costs real
# resources; doing it every poll turns a broken watcher into a busy one.
ASTA_RECOVERY_COOLDOWN=600

# How many times to re-search when a HEADED call window opens the wrong chat.
# Placing a real call exposed this: headless resolve finds the person every time,
# but the headed window paints slower and search can land on the wrong row. A
# mismatch is a timing artefact, so it retries — and after the last attempt it
# still refuses rather than dialling whoever it happened to open.
ASTA_CALL_FIND_ATTEMPTS=4

# How far past his own p90 message length a draft may run before Asta says it
# reads like a bot wrote it. Not a hard cap and it never truncates — cutting a
# message to length can remove the ask, and he sees every draft before it goes;
# what matters is that the overrun is visible at that moment.
ASTA_DRAFT_LENGTH_SLACK=1.5

# Queues/groups Arun is on. A ticket assigned to one of these is assigned to HIM,
# and is never silenced by what that sender usually sends. Comma-separated.
ASTA_MY_GROUPS=OH - TELIKOS - L2

# --- Going and finding out ----------------------------------------------------
# When a colleague asks something checkable — "are prod bookings stuck", "is my PR
# feedback right", "can you look at this error" — Asta investigates it read-only
# and puts the answer in the notification, instead of only forwarding the question.
#
# Analysis tasks only: it may read Temporal, Grafana, a PR and the workspace, and
# it may DRAFT a reply, but every outward move is staged for approval like any
# other. It never consults presence — this runs whether he is at the laptop or not.
ASTA_RESPOND=0
# Investigations started per hour, at most. Ten people pinging must not become ten
# agentic runs against production.
ASTA_RESPOND_MAX_PER_HOUR=4

# --- Reading his actual chats -------------------------------------------------
# The Teams Activity feed lists mentions, replies, reactions and invites, and
# never an ordinary message — so a 1:1 (where every message is for him) was
# invisible unless somebody @mentioned him inside his own DM, and the second
# message of any conversation was invisible because nobody tags twice.
#
# This watches the chat RAIL. Its order is the signal: a chat with a new message
# jumps toward the top, so a quiet poll opens nothing at all.
ASTA_CHATWATCH=0
# How often to compare the rail. One DOM read; no chat is opened unless one moved.
ASTA_CHATWATCH_SECONDS=180
# Chats opened per sweep, at most — each is a real navigation on a profile that
# tolerates a single writer.
ASTA_CHATWATCH_MAX_OPENS=3
# Messages pulled per opened chat.
ASTA_CHATWATCH_READ=12
